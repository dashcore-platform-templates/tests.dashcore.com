APP_NAME=DashCore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dashcore
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

NIGHTWATCH_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Directory holding one checkout per fleet app, named by host (e.g. ~/Herd).
# Unset means nothing is scannable.
SCANNER_ROOT=

# Directories put in front of PATH for scans and builds, e.g. the nvm bin
# directory holding node, npm and claude. The fleet scheduler's PATH is minimal.
SCANNER_PATH=
SCANNER_CLAUDE=claude

# Test builds: open PRs (true) or keep branches local (false); queue one
# build per app nightly.
SCANNER_BUILD_PUBLISH=true
SCANNER_BUILD_NIGHTLY=false

# Proving Ground: the node binary for the browser runner (absolute under
# launchd, whose PATH is minimal), and seconds between journeys.
SIMULATION_NODE=node
SIMULATION_PAUSE=4
# The fake HR app's seeded people, for its tour. Leave unset to use example.com.
# SIMULATION_HR_MANAGER_EMAIL=
# SIMULATION_HR_LINE_MANAGER_EMAIL=

# Fleet membership — the only two values `php artisan bridge:connect` needs.
BRIDGE_FLEET_KEY=
BRIDGE_CONTROL_URL=https://api.dashcore.com

# SSO — fleet sign-in via login.dashcore.com.
# Mode: off | optional | required. Apps start `off`; fleets moves them on
# (fleets docs/sso.md). Break-glass keeps password for listed emails and is
# needed before `required`. BRIDGE_SSO_PROVISION is deliberately not set:
# no Dashcore app creates accounts through SSO.
BRIDGE_SSO_MODE=off
BRIDGE_SSO_BREAK_GLASS=
