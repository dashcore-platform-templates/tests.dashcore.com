{
    "name": "dashcore/design-kit",
    "version": "6.9.0",
    "description": "Applies a design.dashcore.com design file to a Laravel Livewire Flux kit: theme variables, fonts, brand copy, and the three custom components the Dashcore Standard defines.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Dashcore\\DesignKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dashcore\\DesignKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dashcore\\DesignKit\\DesignKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
