<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The suite peaks around 135 MB, past PHP's 128 MB default. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <!-- Tests run on Postgres, like production. Forced (env and server), so
             a DB_* leaked from .env or the shell can never point RefreshDatabase
             at the development database. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="tests_dashcore_testing" force="true"/>
        <server name="DB_DATABASE" value="tests_dashcore_testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <!-- Scan slots are advisory locks in the test database itself (each
             worktree's own), so two suites on one host never take each
             other's slots. -->
        <env name="SCANNER_SLOTS_CONNECTION" value="pgsql" force="true"/>
        <server name="SCANNER_SLOTS_CONNECTION" value="pgsql" force="true"/>
        <!-- Tests run as the home install, whatever the checkout's APP_URL. -->
        <env name="TESTS_FLEET" value="dashcore" force="true"/>
        <server name="TESTS_FLEET" value="dashcore" force="true"/>
        <env name="TESTS_HOST" value="tests.dashcore.com" force="true"/>
        <server name="TESTS_HOST" value="tests.dashcore.com" force="true"/>
        <env name="SCANNER_ROOT" value="" force="true"/>
        <server name="SCANNER_ROOT" value="" force="true"/>
        <!-- The host's .env names gh by absolute path (launchd has no Homebrew
             on PATH); tests assert on the bare command. -->
        <env name="SCANNER_GH" value="gh" force="true"/>
        <server name="SCANNER_GH" value="gh" force="true"/>
        <!-- No test reaches the real fleets checkout, keys checkout or heartbeat. -->
        <env name="TESTS_FLEETS_CHECKOUT" value="" force="true"/>
        <server name="TESTS_FLEETS_CHECKOUT" value="" force="true"/>
        <env name="WORKFLOWS_HEARTBEAT_URL" value="" force="true"/>
        <server name="WORKFLOWS_HEARTBEAT_URL" value="" force="true"/>
        <env name="WORKFLOWS_KEYS_CHECKOUT" value="" force="true"/>
        <server name="WORKFLOWS_KEYS_CHECKOUT" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="BRIDGE_SSO_MODE" value="off" force="true"/>
        <server name="BRIDGE_SSO_MODE" value="off" force="true"/>
    </php>
</phpunit>
